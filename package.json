{
  "name": "contactbook",
  "version": "1.0.0",
  "private": true,
  "description": "ContactBook - an address book with bookmarks, multiple contact methods and Excel import/export, built for the Extreme Programming assignment.",
  "main": "server/src/server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/src/server.js",
    "dev:server": "node --watch server/src/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node server/scripts/seed.js",
    "seed:reset": "node server/scripts/seed.js --reset",
    "test": "node server/scripts/runTests.js",
    "export:sample": "node server/scripts/exportSample.js"
  },
  "keywords": [
    "contactbook",
    "address-book",
    "express",
    "sqlite",
    "excel",
    "vue"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^2.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0"
  }
}
