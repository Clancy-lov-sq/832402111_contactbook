# Every setting is optional: the defaults are the configuration of a local run.
# Copy this file to .env, edit what you need and export it in the shell that starts
# the service (the process does not read .env by itself).

# HTTP server
PORT=8080
HOST=0.0.0.0

# Comma separated list of allowed origins, or * during development.
# Set the exact public origin before exposing the service.
CORS_ORIGIN=*

# Storage: the SQLite file, relative to the repository root.
SQLITE_PATH=data/contactbook.db

# Static front end produced by `npm run build`.
STATIC_DIR=server/public
SERVE_STATIC=true

# debug | info | warn | error
LOG_LEVEL=info
